{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(/**)",
      "Read(~/.claude/projects/**)",
      "Read(~/.claude/**)",
      "Edit(/**)",
      "WebFetch(*)",
      "WebSearch(*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)"
    ],
    "additionalDirectories": [
      "/Users/mathis/.claude/plans"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '=== Git Status ===' && git status -s 2>/dev/null | head -10 || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "agent-kit@agent-kit": true,
    "code-simplifier@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "cloudflare@claude-plugins-official": false,
    "code-modernization@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "ui-design@claude-code-workflows": false,
    "ui-ux-pro-max@ui-ux-pro-max-skill": false,
    "impeccable@impeccable": false
  }
}
